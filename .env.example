# Copy to .env and fill in. Leave everything blank to run in MOCK mode (no model).

# ── Option A: any OpenAI-compatible endpoint you have today ─────────────────
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
PLANNER_MODEL=gpt-4o-mini
BUILDER_MODEL=

# ── Claude (Anthropic) via its OpenAI-compatible endpoint ───────────────────
# Key from the Claude Console. SimGate leaves out `temperature` automatically here,
# because current Claude models reject values below 1 on this endpoint.
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=<your Claude API key>
# PLANNER_MODEL=claude-sonnet-5-5
# BUILDER_MODEL=claude-opus-5-5

# ── Option B: Meta Model API (from kickoff) ─────────────────────────────────
# Docs: https://dev.meta.ai/docs/overview
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_API_KEY=<your Meta key>
# PLANNER_MODEL=muse-spark-1.3
# BUILDER_MODEL=muse-wonder-1.0

# template = reliable spec -> code; llm = the builder model writes the code,
# with compile-check-and-retry and template fallback.
BUILDER_MODE=template
BUILDER_MAX_RETRIES=3
