# SimGate settings. Copy to .env and paste your Meta Model API key into LLM_API_KEY; nothing else needs changing.
# Every model SimGate calls is a Meta model: Muse Spark plans and explains, Muse Wonder proposes robot designs.
# Docs: https://dev.meta.ai/docs/overview
#
# No key (or an invalid one) still works: SimGate starts in mock mode (rules, no model) and says why.
# SIMGATE_MOCK_MODE=1 forces mock mode even with a key.

LLM_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
PLANNER_MODEL=muse-spark-1.3
BUILDER_MODEL=muse-wonder-1.0
SIMGATE_MOCK_MODE=0
